{
  "name": "@second196/skillhub-observer",
  "version": "0.1.0",
  "description": "SkillHub local skill observability collector, HTML report generator, and platform uploader",
  "type": "module",
  "bin": {
    "skillhub-observer": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/mark-executable.cjs dist/index.js && node ./scripts/copy-readme.cjs",
    "test": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cac": "6.7.14"
  },
  "devDependencies": {
    "@types/node": "20.12.7",
    "typescript": "5.4.2"
  }
}
