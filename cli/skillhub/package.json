{
  "name": "@second196/skillhub-cli",
  "version": "0.2.2",
  "description": "Skill Hub CLI for uploading, discovering, and installing skills",
  "type": "module",
  "bin": {
    "skillhub": "dist/index.js",
    "skillhub-cli": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/mark-executable.cjs dist/index.js && node ./scripts/copy-readme.cjs",
    "test": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cac": "6.7.14",
    "fflate": "0.8.2",
    "yaml": "2.8.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "20.12.7",
    "typescript": "5.4.2"
  }
}
